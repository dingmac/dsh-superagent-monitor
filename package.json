{
  "name": "@local/dsh-superagent-monitor",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "A manager and desktop entry for a standalone dsh-superagent: status, launchd service, start/stop, dashboard plugin sync, and the Superagent conversation tab.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
